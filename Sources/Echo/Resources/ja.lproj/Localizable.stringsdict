<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>menu.collected</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>収集済み：%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>other</key>
            <string>%d件</string>
        </dict>
    </dict>
    <key>quick.batch.limit</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>テキストは最大%#@count@まで</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>other</key>
            <string>%d件</string>
        </dict>
    </dict>
    <key>quick.status.selected</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>テキストを%#@count@選択 · ↵で貼り付け</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>d</string>
            <key>other</key>
            <string>%d件</string>
        </dict>
    </dict>
</dict>
</plist>
